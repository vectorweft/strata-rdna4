{
  "_comment": "Qwen3.8-Flash-Next UD-Q4_K_XL on two RDNA4 cards (docs/RDNA4.md): GPU 0 runs every layer, GPU 1 is a helper expert cache that also computes its own experts while a prompt is read. Paths are relative to the repository root (start the server there). Set HIP_VISIBLE_DEVICES to your two cards.",
  "exe": "build-hip/strata",
  "args": [
    "--pack",
    "packs/ud-q4_k_xl",
    "--native",
    "models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf",
    "--ple-gguf",
    "models/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00002-of-00004.gguf",
    "--mtp",
    "mtp/rt-steps52",
    "--spec",
    "4",
    "--spec-min-p",
    "0.3",
    "--expert-profile",
    "data/expert-profile-ud-q4kxl.bin",
    "--kv",
    "int8",
    "--pool-workers",
    "15",
    "--adapt-every",
    "4",
    "--pcie-frac",
    "0",
    "--mmap-experts",
    "--pin-cpu-experts",
    "--expert-cache",
    "auto",
    "--prefill",
    "8192",
    "--max-context",
    "262144",
    "--expert-cache-device1",
    "auto",
    "--vram-reserve-mib",
    "384",
    "--conversation-cache-mib",
    "16384",
    "--conversation-cache-slots",
    "4"
  ],
  "cwd": ".",
  "tokenizer": "packs/ud-q4_k_xl/tokenizer",
  "model_name": "qwen3.8-flash-next",
  "log": "strata-rdna4.log",
  "host": "127.0.0.1",
  "env": {
    "HIP_VISIBLE_DEVICES": "0,1",
    "STRATA_HELPER_RESERVE_MIB": "1536"
  }
}